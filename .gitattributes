# Other text assets: normalize in the repository and use the platform checkout.
*.md       text
*.yml      text
*.yaml     text
*.toml     text
*.cfg      text
*.ini      text

# Windows-specific scripts keep CRLF.
*.bat      text eol=crlf
*.cmd      text eol=crlf
