# Enforce LF line endings for shell scripts so they run on Linux/OpenBayes
# even when edited on Windows.
*.sh       text eol=lf
*.bash     text eol=lf

# Hash-audited source and scientific artifacts must remain byte-stable across
# Windows and Linux checkouts.
*.py       text eol=lf
*.csv      text eol=lf
*.json     text eol=lf
